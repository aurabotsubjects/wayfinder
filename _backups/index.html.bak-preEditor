<!-- ════════════════════════════════════════════════════════════════════
     DATA FILES — one file per term (+ one lesson-plan file per week built).
     Keep this whole folder together: index.html needs everything in /data
     sitting alongside it, in the same relative locations, to load correctly.
     Add new <script> lines here as more terms/weeks of lesson plans are built.
     ════════════════════════════════════════════════════════════════════ -->
<script>
  window.ALL_TERMS = window.ALL_TERMS || {};
  window.ALL_LESSON_PLANS = window.ALL_LESSON_PLANS || {};



// ── All per-day trial images — add new weeks here only ──
// ── Per-term artwork is loaded on demand ────────────────────────────────
// The images live in data/term<N>-images.js. Only the term currently on
// screen is fetched; the other is quietly preloaded once the page is idle.
window.ALL_WEEK_IMAGES = window.ALL_WEEK_IMAGES || {};

const TERM_IMAGE_FILES = {
  'polynesian-migration': 'data/term2-images.js',
  'skybound-baobab-route': 'data/term3-images.js',
};
const _imgLoads = {};   // termKey -> Promise, so each file is requested once

function ensureTermImages(termKey){
  const file = TERM_IMAGE_FILES[termKey];
  if(!file) return Promise.resolve(false);
  if(_imgLoads[termKey]) return _imgLoads[termKey];
  _imgLoads[termKey] = new Promise(resolve=>{
    const s = document.createElement('script');
    s.src = file;
    s.onload = ()=>resolve(true);
    s.onerror = ()=>{ console.warn('Could not load '+file+' — it must sit in /data beside index.html'); resolve(false); };
    document.head.appendChild(s);
  });
  return _imgLoads[termKey];
}

// Fetch the current term's art, then redraw whatever is already on screen.
function loadTermImages(termKey){
  if(window.ALL_WEEK_IMAGES[termKey]){ queuePreload(); return; }   // already in memory
  ensureTermImages(termKey).then(ok=>{
    if(ok && termKey === currentTerm){
      updateHeaderForTerm();
      const area = document.getElementById('trial-area');
      if(area && area.style.display !== 'none') loadTrial();
    }
    queuePreload();                                    // only now go after the rest
  });
}

let _preloadQueued = false;
function queuePreload(){
  if(_preloadQueued) return;
  _preloadQueued = true;
  const idle = window.requestIdleCallback || (fn=>setTimeout(fn, 1200));
  idle(preloadOtherTermImages);
}

// Once the page is quiet, pull the other term down too so switching is instant.
function preloadOtherTermImages(){
  Object.keys(TERM_IMAGE_FILES).forEach(k=>{ if(k !== currentTerm) ensureTermImages(k); });
}

// Which fifth of the strip belongs to each strand (left → right)
const STRAND_PANEL = { History:0, Geography:1, Science:2, Technology:3, Art:4 };
const DAY_PANEL = { Monday:0, Tuesday:1, Wednesday:2, Thursday:3, Friday:4 };

// ── Term 3 introduction (welcome screen + "Meet the crew" modal) ──
function term3IntroHtml(){ return `
  <div class="crew-intro">
    <h2>Skybound: The Baobab Route</h2>
