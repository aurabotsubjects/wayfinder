    </div>
    <p>Each week runs the same five ways of looking at one place: <strong>Monday</strong> History,
    <strong>Tuesday</strong> Geography, <strong>Wednesday</strong> Science,
    <strong>Thursday</strong> Technology, <strong>Friday</strong> Art. Week 5 is the
    <em>Lost City Trial</em> and week 10 the <em>Legacy Trial</em> — the two boss battles where
    the crew proves what it has learned.</p>
    <img class="crew-sheet" src="${window.TERM3_INTRO_IMG || ''}"
         alt="Character sheets for Tapiwa and Nomvula: portraits, key facts and colour palettes"
         onclick="window.open(this.src,'_blank')">
    <span class="crew-sheet-hint">Tapiwa and Nomvula — tap the sheet to open it full size</span>
  </div>`; }

function openTermIntro(){
  document.getElementById('intro-modal-content').innerHTML = term3IntroHtml();
  document.getElementById('intro-overlay').classList.add('open');
}
function closeTermIntro(){
  document.getElementById('intro-overlay').classList.remove('open');
}

// Builds the 5-panel character strip for a day: the lesson's own subject stays
// in full colour, the other four are greyed back. Only the panel artwork is
// dimmed — everything below the name banner is left alone, so the character's
// name and the artwork along the bottom edge stay whole.
function crewStripHtml(weekNum, day, strand){
  if(currentTerm !== 'skybound-baobab-route') return '';
  const map = window.ALL_STORY_SPEAKERS && window.ALL_STORY_SPEAKERS[currentTerm];
  const speaker = map && map[weekNum] && map[weekNum][day];
  const crew = window.TERM3_CREW && window.TERM3_CREW[speaker];
  if(!crew) return '';
  const active = (strand in STRAND_PANEL) ? STRAND_PANEL[strand] : DAY_PANEL[day];
  const cut = +(crew.plateTop * 100).toFixed(1);        // where the name banner starts
  const who = speaker === 'Both' ? 'Tapiwa and Nomvula' : speaker;

  // The inactive panels sit in at most two runs: left of the active one, right of it.
  const runs = [];
  if(active > 0) runs.push([0, active * 20]);
  if(active < 4) runs.push([(active + 1) * 20, 100]);

  // Each run is a rectangle with the name-banner bitten out of its bottom edge,
  // so the banner is never greyed even where it crosses a dimmed panel.
  const nx0 = crew.plateX ? crew.plateX[0] * 100 : 100;
  const nx1 = crew.plateX ? crew.plateX[1] * 100 : 100;
  const poly = (a, b) => {
    const o0 = Math.max(a, nx0), o1 = Math.min(b, nx1);
    const pts = [[a, 0], [b, 0]];
    if(o0 >= o1){ pts.push([b, 100], [a, 100]); }          // no overlap — plain rectangle
    else {
      if(o1 < b) pts.push([b, 100], [o1, 100]); else pts.push([b, cut]);
      pts.push([o1, cut], [o0, cut]);
      if(o0 > a) pts.push([o0, 100], [a, 100]);
    }
    return 'polygon(' + pts.map(q => q[0].toFixed(1) + '% ' + q[1].toFixed(1) + '%').join(',') + ')';
  };
  const grey = runs.map(([a,b]) => `<img class="crew-grey" src="${crew.src}" alt="" aria-hidden="true"
      style="clip-path:${poly(a,b)}">`).join('');

  return `<div class="crew-strip">
      <img class="crew-base" src="${crew.src}" alt="${who} across the five subjects — ${strand} in focus">
      ${grey}
      <div class="crew-focus" style="left:${active*20}%;height:${cut}%"></div>
    </div>`;
}


</script>
