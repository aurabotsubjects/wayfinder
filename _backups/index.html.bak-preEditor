let currentTerm = null

// ── Check data files loaded, populate Term selector ─────
function checkDataAndInit(){
  const termKeys = Object.keys(window.ALL_TERMS)
  if(termKeys.length === 0){
    const banner = document.getElementById('data-error-banner')
    banner.classList.add('show')
    banner.innerHTML = `⚠️ No term data could be loaded. Make sure this file is kept inside its original folder, with the <code>data</code> subfolder sitting alongside it — nothing should be moved or opened on its own.`
    return
  }
  const termSel = document.getElementById('term-sel')
  termSel.innerHTML = ''
  termKeys.forEach(key=>{
    const opt = document.createElement('option')
    opt.value = key
    opt.textContent = window.ALL_TERMS[key].meta.label
    termSel.appendChild(opt)
  })
  currentTerm = termKeys[0]
  termSel.value = currentTerm
  populateWeekSelector()
  updateHeaderForTerm()
  updateProgressUI()
  loadTermImages(currentTerm)
}

function updateHeaderForTerm(){
  const term = window.ALL_TERMS[currentTerm]
  if(!term) return
  document.getElementById('brand-subtitle').textContent = `${term.meta.label} · Year 5/6`
  document.getElementById('welcome-lede').textContent = term.meta.chapterIntro || ''
  const isT3 = currentTerm === 'skybound-baobab-route'
  const slot = document.getElementById('term-intro-slot')
  if(slot) slot.innerHTML = isT3 && window.TERM3_INTRO_IMG ? term3IntroHtml() : ''
  const cb = document.getElementById('crew-btn')
  if(cb) cb.style.display = (isT3 && window.TERM3_INTRO_IMG) ? 'inline-block' : 'none'
}

function onTermChange(){
  currentTerm = document.getElementById('term-sel').value
  loadTermImages(currentTerm)
  populateWeekSelector()
  updateHeaderForTerm()
  updateProgressUI()
  document.getElementById('welcome-screen').style.display='block'
  document.getElementById('trial-area').style.display='none'
}

function populateWeekSelector(){
  const term = window.ALL_TERMS[currentTerm]
  const weekSel = document.getElementById('week-sel')
  weekSel.innerHTML = ''
  const weekNums = Object.keys(term.weeks).map(Number)  // weeks always numeric
  const bossNums = Object.keys(term.bossBattles).map(Number)
  const allWeeks = [...new Set([...weekNums, ...bossNums])].sort((a,b)=>a-b)
  allWeeks.forEach(w=>{
    const isBoss = !!term.bossBattles[w]
    const opt = document.createElement('option')
    opt.value = w
    opt.textContent = isBoss ? `Week ${w} — ⚔ Boss Battle` : `Week ${w}`
    weekSel.appendChild(opt)
  })
  onWeekChange()
}

function onWeekChange(){
  const w = parseInt(document.getElementById('week-sel').value)
  const term = window.ALL_TERMS[currentTerm]
  const isBoss = !!term.bossBattles[w]
  document.getElementById('day-sel-group').style.display = isBoss ? 'none' : 'flex'
}

// ── Progress tracking (localStorage, per term) ──────────
function getProgress(){
  try{ return JSON.parse(localStorage.getItem('wayfinder_progress_t'+currentTerm)) || {trials:[]} }
  catch(e){ return {trials:[]} }
}
function saveProgress(p){ localStorage.setItem('wayfinder_progress_t'+currentTerm, JSON.stringify(p)) }
function markTrialComplete(num){
  const p = getProgress()
  if(!p.trials.includes(num)) p.trials.push(num)
  saveProgress(p)
  updateProgressUI()
}
function totalTrialsForTerm(){
  const term = window.ALL_TERMS[currentTerm]
  if(!term) return 0
  return Object.keys(term.weeks).length * 5
}
function updateProgressUI(){
  if(!currentTerm) return
  const p = getProgress()
  const count = p.trials.length
  const total = totalTrialsForTerm()
  document.getElementById('progress-count').textContent = count
  document.getElementById('progress-total').textContent = total
  document.getElementById('progress-fill').style.width = (total ? Math.round(count/total*100) : 0)+'%'
  const restless = count < total/2
  const heroCompass = document.getElementById('hero-compass')
  if(heroCompass) heroCompass.classList.toggle('restless', restless)
}

// CSS spin for restless compass
const styleEl = document.createElement('style')
styleEl.textContent = `
  .restless #hero-needle{animation:spin 3.5s linear infinite}
  @keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
`
document.head.appendChild(styleEl)

// ── Load a trial or boss battle ─────────────────────────
function loadTrial(){
  if(!currentTerm) return
  const w = parseInt(document.getElementById('week-sel').value)
  document.getElementById('welcome-screen').style.display='none'
  const area = document.getElementById('trial-area')
  area.style.display='block'

  const term = window.ALL_TERMS[currentTerm]
  const boss = term.bossBattles[w]
  if(boss){ renderBossBattle(area, w, boss); return }

  const week = term.weeks[w]
  const day = document.getElementById('day-sel').value
  if(!week || !week.days[day]){
    area.innerHTML = `<div style="text-align:center;padding:3rem 0;color:var(--ink-muted)">This part of the voyage hasn't been charted yet.</div>`
    return
  }
  renderTrial(area, w, day, week)
}

function renderTrial(area, weekNum, day, week){
  const t = week.days[day]
  const col = DAY_COLOURS_HEX[day]
  const progress = getProgress()
  const done = progress.trials.includes(t.trialNum)

  const hasLessonPlan = window.ALL_LESSON_PLANS[currentTerm] && window.ALL_LESSON_PLANS[currentTerm][weekNum] && window.ALL_LESSON_PLANS[currentTerm][weekNum][day]
  const lessonPlanBtnHtml = hasLessonPlan
    ? `<button class="lesson-plan-btn" onclick="openLessonPlan(${weekNum}, '${day}')">📋 Full Lesson Plan (Teacher View) →</button>`
    : ''

  let tagsHtml = ''
  let tagPanelsHtml = ''
  const tagDefs = []
  if(t.curriculum) tagDefs.push({label:'🎓 NZ Curriculum', body:t.curriculum})
  if(t.bible) tagDefs.push({label:'✝️ Bible Connection', body:t.bible})
  if(t.value && VALUES_MAP[t.value]){
    const v = VALUES_MAP[t.value]
    tagDefs.push({label:'💛 '+v.label, body:`This trial leans on our school value of <strong>${v.label}</strong> — <em>${v.desc}</em>.`})
  }
  tagDefs.forEach((td,i)=>{
    tagsHtml += `<button class="tag-btn" onclick="toggleTag(${i})">${td.label}</button>`
    tagPanelsHtml += `<div class="tag-panel" id="tag-panel-${i}">${td.body}</div>`
  })

  area.innerHTML = `
    <div class="trial-meta">
      <span class="badge" style="background:${col}">${day}</span>
      <span class="badge badge-muted">${t.strand}</span>
      <span class="chapter-tag">Week ${weekNum} · "${week.chapter}"</span>
    </div>
    <h1 class="trial-title"><span class="num">Trial ${t.trialNum}</span>${t.trialName}</h1>

    ${weekNum === 1 && typeof WEEK1_BANNER !== 'undefined' ? `
    <div class="trial-banner">
      <img src="${WEEK1_BANNER}" alt="The Hōkūleʻa voyaging canoe at sunset on the open Pacific">
      <span class="banner-caption">The Hōkūleʻa — a real double-hulled voyaging waka hourua</span>
    </div>` : ''}

    <div class="story-panel">
      ${crewStripHtml(weekNum, day, t.strand)}
      ${currentTerm === 'polynesian-migration' && typeof TAMA_BASIC !== 'undefined' ? `
      <div class="tama-portrait"><img src="${day === 'Tuesday' ? TAMA_TUESDAY : day === 'Wednesday' ? TAMA_WEDNESDAY : day === 'Thursday' ? TAMA_THURSDAY : day === 'Friday' ? TAMA_FRIDAY : TAMA_BASIC}" alt="Tama"></div>` : ''}
      <span class="story-label">${(function(){
        const speakerMap = window.ALL_STORY_SPEAKERS && window.ALL_STORY_SPEAKERS[currentTerm];
        const speaker = speakerMap && speakerMap[weekNum] && speakerMap[weekNum][day];
        if(speaker === 'Tapiwa') return `Tapiwa's story`;
        if(speaker === 'Nomvula') return `Nomvula's story`;
        if(speaker === 'Both') return `Tapiwa & Nomvula's story`;
        return `Tama's Journal`;
      })()}</span>
      ${t.story}
    </div>

    ${(function(){ const termImgs = ALL_WEEK_IMAGES[currentTerm] || {}; const img = termImgs[weekNum] && termImgs[weekNum][day]; return img ? `
    <div class="trial-img-wrap">
      <img src="${img.src}" alt="${img.caption}" class="${img.diagram ? 'diagram' : ''}">
      <span class="trial-img-caption">${img.caption}</span>
    </div>` : ''; })()}

    ${(function(){
      const faith = window.ALL_TRIAL_FAITH && window.ALL_TRIAL_FAITH[currentTerm] &&
        window.ALL_TRIAL_FAITH[currentTerm][weekNum] && window.ALL_TRIAL_FAITH[currentTerm][weekNum][day];
      if (!faith) return '';
      return `<div class="faith-card">
        <div class="faith-card-header"><span class="faith-cross">✞</span><span class="faith-card-title">Faith Connection</span></div>
        <p class="faith-ponder">${faith.ponder}</p>
        <div class="faith-verse">
          <span class="faith-verse-text">"${faith.verse}"</span>
          <span class="faith-verse-ref">${faith.ref}</span>
        </div>
        <div class="faith-value">
          <span class="faith-value-tag">${faith.value}</span>
          <span class="faith-value-text">${faith.valueDesc}</span>
        </div>
        <div class="faith-questions">
          <div class="faith-q-title">✦ Reflect</div>
          ${faith.questions.map((q,i) => '<div class="faith-q"><span class="faith-q-num">'+(i+1)+'</span><span>'+q+'</span></div>').join('')}
        </div>
        <div class="faith-motto">Soli Deo Gloria</div>
      </div>`;
    })()}

    <div class="sec-card" style="--accent:${col}">
      <div class="sec-head"><span class="sec-icon">🤝</span><h3 class="sec-title">Let's Do This Together</h3></div>
      <div class="sec-body"><p>${t.activity}</p></div>
    </div>

    <div class="sec-card" style="--accent:${col}">
      <div class="sec-head"><span class="sec-icon">⚔️</span><h3 class="sec-title">Your Quest</h3></div>
      <div class="sec-body"><p>${t.quest}</p></div>
    </div>

    <div class="sec-card" style="--accent:${col}">
      <div class="sec-head"><span class="sec-icon">🎨</span><h3 class="sec-title">Express It</h3></div>
      <div class="sec-body"><p>${t.creative}</p></div>
    </div>

    <div class="tags-row">${tagsHtml}</div>
    ${tagPanelsHtml}

    ${lessonPlanBtnHtml}

    <button class="complete-btn" id="complete-btn" onclick="completeTrial(${t.trialNum})" ${done?'disabled style="opacity:.55"':''}>
      ${done ? '✓ Trial already complete' : '✓ Complete This Trial'}
    </button>

    <div class="wakes-panel" id="wakes-panel" style="display:${done?'block':'none'}">
      <div class="sec-head"><span class="sec-icon">📖</span><h3 class="sec-title">The Journal Wakes</h3></div>
      <div class="sec-body">${t.journalWakes}</div>
    </div>

    <div class="trial-nav">
      <button class="nav-btn" onclick="gotoAdjacent(-1)">← Previous Day</button>
      <button class="nav-btn" onclick="gotoAdjacent(1)">Next Day →</button>
    </div>
  `
}

function toggleTag(i){
  document.getElementById('tag-panel-'+i).classList.toggle('open')
}

function completeTrial(num){
  markTrialComplete(num)
  document.getElementById('complete-btn').textContent = '✓ Trial complete'
  document.getElementById('complete-btn').disabled = true
  document.getElementById('complete-btn').style.opacity = .55
  document.getElementById('wakes-panel').style.display = 'block'
}

function gotoAdjacent(dir){
  const weekSel = document.getElementById('week-sel')
  const term = window.ALL_TERMS[currentTerm]
  let w = parseInt(weekSel.value)
  let dayIdx = DAYS.indexOf(document.getElementById('day-sel').value)
  dayIdx += dir
  const weekNums = Array.from(weekSel.options).map(o=>parseInt(o.value))
  const minW = Math.min(...weekNums), maxW = Math.max(...weekNums)
  if(dayIdx<0){ w = Math.max(minW, w-1); dayIdx = 4 }
  if(dayIdx>4){ w = Math.min(maxW, w+1); dayIdx = 0 }
  weekSel.value = w
  onWeekChange()
  if(!term.bossBattles[w]) document.getElementById('day-sel').value = DAYS[dayIdx]
  loadTrial()
}

// ── Boss battle rendering ───────────────────────────────
function getBossScores(weekNum){
  try{ return JSON.parse(localStorage.getItem('wayfinder_boss_t'+currentTerm+'_w'+weekNum)) || {a:0,b:0,teamA:'Team 1',teamB:'Team 2'} }
  catch(e){ return {a:0,b:0,teamA:'Team 1',teamB:'Team 2'} }
}
function saveBossScores(weekNum, s){ localStorage.setItem('wayfinder_boss_t'+currentTerm+'_w'+weekNum, JSON.stringify(s)) }

function renderBossBattle(area, weekNum, boss){
  const s = getBossScores(weekNum)
  const lessonPlansForWeek = window.ALL_LESSON_PLANS[currentTerm] && window.ALL_LESSON_PLANS[currentTerm][weekNum]
  let lessonPlanButtonsHtml = ''
  if(lessonPlansForWeek){
    const dayLabels = Object.keys(lessonPlansForWeek).map(day=>{
      const l = lessonPlansForWeek[day]
      return `<button class="lesson-plan-btn" style="margin-bottom:.5rem" onclick="openLessonPlan(${weekNum}, '${day}')">📋 ${l.sessionLabel} →</button>`
    }).join('')
    lessonPlanButtonsHtml = `
      <div style="margin:1.5rem 0">
        <p style="text-align:center;color:var(--ink-faint);font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.6rem">Station Lesson Plans (Teacher View)</p>
        ${dayLabels}
      </div>
    `
  }

  area.innerHTML = `
    <div class="boss-header">
      <div class="badge" style="background:var(--gold);color:#1c1306;display:inline-block;margin-bottom:.6rem">⚔ Boss Battle</div>
      <h1>${boss.title}</h1>
      <p>${boss.subtitle}</p>
      <p style="margin-top:1rem">${boss.intro}</p>
    </div>

    <div style="text-align:center;margin:1rem 0;padding:1.2rem;background:rgba(200,146,42,.08);border:1px solid var(--gold);border-radius:14px">
      <div style="font-family:'Cinzel',serif;font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:.5rem">⚡ Kahoot-Style Quiz Mode</div>
      <p style="font-size:.85rem;color:var(--ink-faint);margin-bottom:.8rem">Students join on their iPads via QR code — live scoring, boat race, speed bonuses!</p>
      <a href="bossbattle.html?week=${weekNum}" target="_blank" style="display:inline-block;background:linear-gradient(135deg,var(--gold),#f0b830);color:#1c1306;font-family:'Cinzel',serif;font-weight:700;font-size:.95rem;padding:.7rem 2rem;border-radius:10px;text-decoration:none;letter-spacing:.06em;box-shadow:0 4px 12px rgba(200,146,42,.3)">🎮 Launch Sea Trial Quiz →</a>
    </div>

    ${boss.stations.map(st=>`
      <div class="station-card">
        <div class="station-icon">${st.icon}</div>
        <div><p class="station-name">${st.name}</p><p class="station-desc">${st.desc}</p></div>
      </div>
    `).join('')}

    ${lessonPlanButtonsHtml}

    <div class="team-score-row">
      <div class="team-score">
        <input id="teamA-name" value="${s.teamA}" onchange="updateTeamName(${weekNum},'a',this.value)">
        <div class="score-num" id="teamA-score">${s.a}</div>
        <div class="score-btns">
          <button onclick="adjustScore(${weekNum},'a',-1)">−</button>
          <button onclick="adjustScore(${weekNum},'a',1)">+</button>
        </div>
      </div>
      <div class="team-score">
        <input id="teamB-name" value="${s.teamB}" onchange="updateTeamName(${weekNum},'b',this.value)">
        <div class="score-num" id="teamB-score">${s.b}</div>
        <div class="score-btns">
          <button onclick="adjustScore(${weekNum},'b',-1)">−</button>
          <button onclick="adjustScore(${weekNum},'b',1)">+</button>
        </div>
      </div>
    </div>

    <div class="outro-box">${boss.outro}</div>
  `
}
function adjustScore(weekNum, team, delta){
  const s = getBossScores(weekNum)
  s[team] = Math.max(0, (s[team]||0) + delta)
  saveBossScores(weekNum, s)
  document.getElementById(team==='a'?'teamA-score':'teamB-score').textContent = s[team]
}
function updateTeamName(weekNum, team, val){
  const s = getBossScores(weekNum)
  if(team==='a') s.teamA = val; else s.teamB = val
  saveBossScores(weekNum, s)
}

// ── Lesson Plan modal (teacher view) ────────────────────
function mdLiteToHtml(text){
  const blocks = String(text).split(/\n\n+/)
  return blocks.map(block=>{
    const lines = block.split(/\n/).map(l=>l.trim()).filter(Boolean)
    return lines.map(line=>{
      let html = line.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      return `<p>${html}</p>`
    }).join('')
  }).join('')
}

function buildLessonPlanHtml(lesson){
  const aos = lesson.aos || []
  const learningIntentions = lesson.learningIntentions || []
  const resources = lesson.resources || []
  const mainContent = lesson.mainContent || []
  const videos = lesson.videos || []
  const studentAgency = lesson.studentAgency || {}

  const naItem = '<li><em>Not provided for this lesson.</em></li>'
  const aosHtml = aos.length ? aos.map(a=>`<li>${a}</li>`).join('') : naItem
  const liHtml = learningIntentions.length ? learningIntentions.map(a=>`<li>${a}</li>`).join('') : naItem
  const resourcesHtml = resources.length ? resources.map(a=>`<li>${a}</li>`).join('') : naItem
  const mainContentHtml = mainContent.length ? mainContent.map((sec,i)=>`
    <div class="lp-subblock">
      <strong>${i+1}. ${sec.title}</strong>
      <ul>${(sec.points||[]).map(p=>`<li>${p}</li>`).join('')}</ul>
    </div>
  `).join('') : '<p><em>Not provided for this lesson.</em></p>'
  const videosHtml = videos.length ? videos.map(v=>`<li><strong>${v.title}</strong> — Search YouTube: "${v.search}" — <em>Suitable because:</em> ${v.why}</li>`).join('') : naItem

  const agencyKeys = [['art','🎨 Art Focus'],['readWrite','📚 Read & Write Focus'],['technology','💻 Technology Focus'],['watchReview','🎥 Watch & Review Focus']]
  const agencyHtml = agencyKeys.map(([key,label])=>{
    const a = studentAgency[key]
    if(!a) return `<div class="lp-agency-card"><h5>${label}</h5><p><em>Not provided for this lesson.</em></p></div>`
    return `<div class="lp-agency-card"><h5>${label}</h5><p><strong>${a.title}</strong></p>${mdLiteToHtml(a.body)}</div>`
  }).join('')

  return `
    <h2 class="lp-title">${lesson.day} — ${lesson.strand}: ${lesson.sessionLabel}</h2>
    <p class="lp-sub">${lesson.topic}</p>

    <div class="lp-meta-grid">
      <div class="lp-meta-item"><span class="k">Curriculum Area</span><span class="v">${lesson.curriculumArea}</span></div>
      <div class="lp-meta-item"><span class="k">Duration</span><span class="v">30 minutes</span></div>
      <div class="lp-meta-item"><span class="k">Key Competencies</span><span class="v">${lesson.keyCompetencies}</span></div>
    </div>

    <div class="lp-section"><h4>Achievement Objectives</h4><ul>${aosHtml}</ul></div>
    <div class="lp-section"><h4>Learning Intentions</h4><ul>${liHtml}</ul></div>
    <div class="lp-section"><h4>Assessment</h4><p>${lesson.assessment}</p></div>

    <div class="lp-section"><h4>Introduction</h4><p>${lesson.introduction.replace(/\n\n+/g,'</p><p>')}</p></div>
    <div class="lp-section"><h4>Main Lesson Content</h4>${mainContentHtml}</div>
    <div class="lp-section"><h4>Finishing / Wrap-up</h4><p>Exit Ticket: "${lesson.exitTicket}"</p></div>
    <div class="lp-section"><h4>Resources</h4><ul>${resourcesHtml}</ul></div>
    <div class="lp-section"><h4>Recommended Videos &amp; Online Resources</h4><ul>${videosHtml}</ul></div>
    <div class="lp-section"><h4>Student Agency — students choose their activity</h4><div class="lp-agency-grid">${agencyHtml}</div></div>

    ${lesson.faith ? `
    <div class="lp-section">
      <div class="lp-faith">
        <h4>✞ Faith Connection — Soli Deo Gloria</h4>
        <p class="lp-faith-ponder">${lesson.faith.ponder}</p>
        <div class="lp-faith-verse">
          <em>"${lesson.faith.verse}"</em>
          <small>${lesson.faith.ref}</small>
        </div>
        <div class="lp-faith-value">
          <span class="lp-faith-tag">${lesson.faith.value}</span>
          <span>${lesson.faith.valueDesc}</span>
        </div>
        <div class="lp-faith-qs">
          <strong style="font-size:.78rem;color:#8a5e1a;font-family:'Cinzel',serif;letter-spacing:.06em">✦ Reflective Questions</strong>
          ${lesson.faith.questions.map((q,i) => '<div class="lp-faith-q"><span class="lp-faith-q-num">'+(i+1)+'</span><span>'+q+'</span></div>').join('')}
        </div>
        <div class="lp-faith-motto">Soli Deo Gloria — To God Alone the Glory</div>
      </div>
    </div>` : ''}
  `
}

function openLessonPlan(weekNum, day){
  const lesson = window.ALL_LESSON_PLANS[currentTerm][weekNum][day]
  const el = document.getElementById('lesson-plan-content')

  el.innerHTML = buildLessonPlanHtml(lesson) + `<p class="lp-print-note">Tip: use the 🖨️ Print button above to print this lesson plan or save it as a PDF.</p>`

  document.getElementById('lesson-plan-overlay').classList.add('open')
}

function closeLessonPlan(){
  document.getElementById('lesson-plan-overlay').classList.remove('open')
}

function printLessonPlan(){
  document.body.classList.add('printing-lesson-plan')
  window.print()
}

// ── Print every lesson plan for the current topic, one after another ──
const DAY_PRINT_ORDER = ['Monday','Tuesday','Wednesday','Thursday','Friday']

function printAllLessonPlans(){
  const termPlans = window.ALL_LESSON_PLANS[currentTerm]
  if(!currentTerm || !termPlans){
    alert('No lesson plans are loaded for this topic yet.')
    return
  }
  const weekNums = Object.keys(termPlans).map(Number).sort((a,b)=>a-b)
  let combined = ''
  let count = 0
  weekNums.forEach(w=>{
    DAY_PRINT_ORDER.forEach(day=>{
      const lesson = termPlans[w][day]
      if(!lesson) return
      count++
      combined += `<div class="lp-print-page"><div class="lp-week-tag">Week ${w}</div>${buildLessonPlanHtml(lesson)}</div>`
    })
  })
  if(count === 0){
    alert('No lesson plans are loaded for this topic yet.')
    return
  }
  document.getElementById('lesson-plan-content').innerHTML = combined
  document.getElementById('lesson-plan-overlay').classList.add('open')
  document.body.classList.add('printing-lesson-plan')
  document.body.classList.add('printing-all-plans')
  window.print()
}

window.addEventListener('afterprint', function(){
  document.body.classList.remove('printing-lesson-plan')
  document.body.classList.remove('printing-all-plans')
})

// ── Boot ─────────────────────────────────────────────────
checkDataAndInit()
</script>
