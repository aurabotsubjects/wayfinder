<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Wayfinder's Journal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg-a:#06121f; --bg-b:#0b2335; --bg-c:#0e3247;
  --card:#0e2638; --card-2:#123048; --card-border:rgba(255,255,255,.09);
  --ink:#eef5f8; --ink-muted:rgba(238,245,248,.62); --ink-faint:rgba(238,245,248,.4);
  --gold:#d9a85c; --gold-soft:rgba(217,168,92,.16);
  --teal:#2ec4b6;
  --parch:#f3ead2; --parch-ink:#2c2013; --parch-edge:#c9b585;
  --mon:#e15c4f; --tue:#e8954a; --wed:#2ec4b6; --thu:#9b6fd1; --fri:#e8c14a;
  --radius:14px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:
    radial-gradient(ellipse 1200px 700px at 50% -10%, var(--bg-c), transparent),
    linear-gradient(180deg, var(--bg-a), var(--bg-b) 60%, var(--bg-a));
  color:var(--ink);
  font-family:'Outfit',sans-serif;
  min-height:100vh;
  line-height:1.55;
}
h1,h2,h3,.display{font-family:'Cinzel',serif;letter-spacing:.02em}
a{color:var(--gold)}

/* ── Header ─────────────────────────────────────────── */
.site-header{
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;
  padding:1.1rem 1.5rem; border-bottom:1px solid var(--card-border);
  background:linear-gradient(180deg, rgba(0,0,0,.18), transparent);
}
.brand{display:flex;align-items:center;gap:.75rem}
.brand-mark{width:38px;height:38px;flex:none}
.brand-text h1{font-size:1.15rem;margin:0;color:var(--gold);font-weight:700}
.brand-text p{margin:0;font-size:.72rem;color:var(--ink-muted);letter-spacing:.06em;text-transform:uppercase}

.progress-pill{
  display:flex;align-items:center;gap:.55rem;background:var(--card);border:1px solid var(--card-border);
  padding:.4rem .8rem;border-radius:999px;font-size:.78rem;color:var(--ink-muted)
}
.progress-pill strong{color:var(--gold)}
.progress-bar{width:90px;height:5px;border-radius:99px;background:rgba(255,255,255,.1);overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--gold),var(--teal));transition:width .4s ease}

/* ── Selector bar ───────────────────────────────────── */
.selector-bar{
  display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;
  padding:.85rem 1.5rem;background:rgba(0,0,0,.16);border-bottom:1px solid var(--card-border);
}
.sel-group{display:flex;flex-direction:column;gap:.2rem}
.sel-group label{font-size:.68rem;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.07em}
select{
  background:var(--card-2);color:var(--ink);border:1px solid var(--card-border);
  padding:.5rem .7rem;border-radius:10px;font-family:'Outfit';font-size:.88rem;min-width:150px
}
.go-btn{
  align-self:flex-end;background:linear-gradient(135deg,var(--gold),#c4914f);color:#1c1306;border:none;
  padding:.6rem 1.3rem;border-radius:10px;font-weight:700;font-size:.88rem;cursor:pointer;
  box-shadow:0 4px 14px rgba(217,168,92,.25);transition:transform .15s ease
}
.go-btn:hover{transform:translateY(-1px)}

/* ── Main layout ────────────────────────────────────── */
.main-content{max-width:880px;margin:0 auto;padding:2.2rem 1.5rem 4rem}

/* ── Welcome screen ─────────────────────────────────── */
.welcome{text-align:center}
.compass-hero{width:120px;height:120px;margin:0 auto 1.2rem}
.welcome h1{font-size:clamp(1.7rem,5vw,2.6rem);margin:.2rem 0;color:var(--ink)}
.welcome h1 em{color:var(--gold);font-style:normal}
.welcome .lede{max-width:560px;margin:0 auto 1.6rem;color:var(--ink-muted);font-size:1rem}
.day-legend{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.7rem;margin:1.6rem 0}
.day-legend-item{
  background:var(--card);border:1px solid var(--card-border);border-radius:var(--radius);
  padding:.9rem .8rem;text-align:left
}
.dot-label{display:flex;align-items:center;gap:.5rem;margin-bottom:.35rem}
.dot{width:11px;height:11px;border-radius:50%}
.day-name{font-weight:600;font-size:.88rem}
.day-strand{font-size:.72rem;color:var(--ink-faint)}
.day-quest{font-size:.78rem;color:var(--ink-muted)}
.begin-cta{margin-top:1.4rem;background:linear-gradient(135deg,var(--gold),#c4914f);color:#1c1306;border:none;
  padding:.8rem 1.8rem;border-radius:12px;font-weight:700;font-size:1rem;cursor:pointer;font-family:'Cinzel',serif;
  box-shadow:0 6px 20px rgba(217,168,92,.3)}
.print-all-btn{margin-top:1.4rem;background:transparent;color:var(--teal);border:1px solid var(--teal);
  padding:.8rem 1.6rem;border-radius:12px;font-weight:700;font-size:.92rem;cursor:pointer;font-family:'Outfit'}
.print-all-btn:hover{background:rgba(46,196,182,.1)}
.lp-week-tag{
  display:inline-block;background:var(--gold-soft);border:1px solid var(--gold);color:var(--gold);
  font-family:'Cinzel',serif;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;
  padding:.25rem .7rem;border-radius:999px;margin-bottom:.8rem
}

/* ── Trial header ───────────────────────────────────── */
.trial-meta{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-bottom:.5rem}
.badge{padding:.3rem .7rem;border-radius:999px;font-size:.75rem;font-weight:700;color:#1c1306}
.badge-muted{background:var(--card);color:var(--ink-muted);font-weight:500;border:1px solid var(--card-border)}
.chapter-tag{font-size:.78rem;color:var(--ink-faint);letter-spacing:.04em}
.trial-title{font-size:clamp(1.4rem,4vw,2rem);margin:.3rem 0 1.2rem}
.trial-title .num{color:var(--ink-faint);font-size:.6em;display:block;font-family:'Outfit';letter-spacing:.1em;text-transform:uppercase;margin-bottom:.3rem}

/* ── Story panel (journal page) ─────────────────────── */
.story-panel{
  background:var(--parch);color:var(--parch-ink);border-radius:10px;
  padding:1.4rem 1.5rem;margin-bottom:1.3rem;position:relative;
  box-shadow:0 10px 30px rgba(0,0,0,.35), inset 0 0 0 1px var(--parch-edge);
  font-family:'Outfit'; font-size:1rem;
}
.story-panel::before{
  content:'📖'; position:absolute; top:-14px; left:1.3rem; font-size:1.3rem;
  background:var(--bg-a); padding:.15rem .4rem; border-radius:50%;
}
.story-label{font-family:'Cinzel',serif;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:#7a5a23;margin-bottom:.5rem;display:block}

/* ── Section cards ──────────────────────────────────── */
.sec-card{
  background:var(--card);border:1px solid var(--card-border);border-radius:var(--radius);
  padding:1.2rem 1.3rem;margin-bottom:1.1rem; border-left:3px solid var(--accent,var(--gold))
}
.sec-head{display:flex;align-items:center;gap:.55rem;margin-bottom:.55rem}
.sec-icon{font-size:1.15rem}
.sec-title{font-family:'Cinzel',serif;font-size:.95rem;color:var(--accent,var(--gold));margin:0}
.sec-body{color:var(--ink);font-size:.95rem}
.sec-body p{margin:.2rem 0}

/* ── Tags row (bible/value/curriculum) ──────────────── */
.tags-row{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0 1.4rem}
.tag-btn{
  background:transparent;border:1px solid var(--card-border);color:var(--ink-muted);
  padding:.35rem .7rem;border-radius:999px;font-size:.74rem;cursor:pointer
}
.tag-panel{
  background:rgba(255,255,255,.04);border:1px solid var(--card-border);border-radius:10px;
  padding:.8rem 1rem;font-size:.85rem;color:var(--ink-muted);margin-bottom:.8rem;display:none
}
.tag-panel.open{display:block}

/* ── Complete trial / journal wakes ─────────────────── */
.complete-btn{
  display:block;width:100%;background:linear-gradient(135deg,var(--teal),#1f9d92);
  color:#06231f;border:none;padding:.85rem;border-radius:12px;font-weight:700;font-size:1rem;
  cursor:pointer;font-family:'Cinzel',serif;margin-top:.6rem
}
.wakes-panel{
  margin-top:1.3rem;background:linear-gradient(135deg, var(--gold-soft), transparent);
  border:1px solid rgba(217,168,92,.35);border-radius:var(--radius);padding:1.2rem 1.3rem;
  animation:pageIn .5s ease;
}
@keyframes pageIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.wakes-panel .sec-title{color:var(--gold)}
.wakes-panel .sec-body{font-style:italic;color:var(--ink)}

/* ── Nav buttons between days ────────────────────────── */
.trial-nav{display:flex;justify-content:space-between;margin-top:1.8rem;gap:.7rem}
.nav-btn{
  background:var(--card-2);border:1px solid var(--card-border);color:var(--ink);
  padding:.6rem 1.1rem;border-radius:10px;font-size:.85rem;cursor:pointer
}
.nav-btn:disabled{opacity:.3;cursor:not-allowed}

/* ── Boss Battle view ────────────────────────────────── */
.boss-header{text-align:center;margin-bottom:1.5rem}
.boss-header h1{font-size:clamp(1.6rem,5vw,2.3rem);color:var(--gold);margin:.3rem 0}
.boss-header p{color:var(--ink-muted);max-width:600px;margin:0 auto}
.station-card{
  background:var(--card);border:1px solid var(--card-border);border-radius:var(--radius);
  padding:1.1rem 1.2rem;margin-bottom:.9rem;display:flex;gap:.9rem;align-items:flex-start
}
.station-icon{font-size:1.6rem}
.station-name{font-weight:700;margin:0 0 .25rem;font-family:'Cinzel',serif;font-size:.92rem}
.station-desc{color:var(--ink-muted);font-size:.88rem;margin:0}
.team-score-row{display:flex;align-items:center;gap:1.5rem;justify-content:center;margin:1.5rem 0;flex-wrap:wrap}
.team-score{background:var(--card);border:1px solid var(--card-border);border-radius:var(--radius);padding:1rem 1.4rem;text-align:center;min-width:140px}
.team-score input{
  background:transparent;border:none;color:var(--ink);text-align:center;font-size:.85rem;font-family:'Outfit';
  border-bottom:1px dashed var(--card-border);width:100%;margin-bottom:.5rem
}
.score-num{font-size:2.2rem;font-family:'Cinzel',serif;color:var(--gold)}
.score-btns{display:flex;gap:.5rem;justify-content:center;margin-top:.5rem}
.score-btns button{
  background:var(--card-2);border:1px solid var(--card-border);color:var(--ink);width:32px;height:32px;
  border-radius:8px;cursor:pointer;font-size:1rem
}
.outro-box{
  background:var(--parch);color:var(--parch-ink);border-radius:10px;padding:1.1rem 1.3rem;
  margin-top:1.3rem;font-size:.92rem
}

/* ── Footer ──────────────────────────────────────────── */
.site-footer{
  text-align:center;color:var(--ink-faint);font-size:.78rem;padding:1.5rem;border-top:1px solid var(--card-border)
}

/* ── Lesson plan button + modal ──────────────────────── */
.lesson-plan-btn{
  display:block;width:100%;background:var(--card-2);border:1px solid var(--gold);color:var(--gold);
  padding:.7rem;border-radius:12px;font-weight:600;font-size:.88rem;cursor:pointer;margin-bottom:.8rem;
  font-family:'Outfit';transition:background .15s ease
}
.lesson-plan-btn:hover{background:var(--gold-soft)}

.modal-overlay{
  display:none;position:fixed;inset:0;background:rgba(2,8,14,.78);z-index:50;
  align-items:flex-start;justify-content:center;padding:2.5rem 1rem;overflow-y:auto
}
.modal-overlay.open{display:flex}
.modal-box{
  background:var(--bg-b);border:1px solid var(--card-border);border-radius:16px;
  max-width:760px;width:100%;padding:2rem 1.8rem 2.5rem;position:relative;
  box-shadow:0 20px 60px rgba(0,0,0,.5)
}
.modal-close{
  position:absolute;top:1rem;right:1rem;background:var(--card-2);border:1px solid var(--card-border);
  color:var(--ink);width:34px;height:34px;border-radius:50%;cursor:pointer;font-size:1rem
}
.lp-title{font-family:'Cinzel',serif;color:var(--gold);font-size:1.4rem;margin:0 0 .2rem}
.lp-sub{color:var(--ink-muted);font-size:.85rem;margin:0 0 1.3rem}
.lp-meta-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.6rem;margin-bottom:1.3rem}
.lp-meta-item{background:var(--card);border:1px solid var(--card-border);border-radius:10px;padding:.6rem .8rem}
.lp-meta-item .k{font-size:.66rem;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-faint);display:block;margin-bottom:.15rem}
.lp-meta-item .v{font-size:.85rem;color:var(--ink)}
.lp-section{margin-bottom:1.2rem}
.lp-section h4{font-family:'Cinzel',serif;color:var(--teal);font-size:.92rem;margin:0 0 .5rem;border-bottom:1px solid var(--card-border);padding-bottom:.35rem}
.lp-section ul{margin:.3rem 0;padding-left:1.2rem}
.lp-section li{margin-bottom:.4rem;font-size:.9rem;color:var(--ink)}
.lp-section p{font-size:.9rem;color:var(--ink);margin:.3rem 0}
.lp-subblock{background:var(--card);border-left:3px solid var(--teal);border-radius:8px;padding:.7rem .9rem;margin-bottom:.7rem}
.lp-subblock strong{color:var(--gold)}
.lp-agency-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:.8rem}
.lp-agency-card{background:var(--card);border:1px solid var(--card-border);border-radius:10px;padding:.8rem .9rem}
.lp-agency-card h5{margin:0 0 .4rem;font-size:.82rem;color:var(--gold);font-family:'Cinzel',serif}
.lp-agency-card p{font-size:.82rem;color:var(--ink-muted);margin:.2rem 0}
.lp-print-note{font-size:.76rem;color:var(--ink-faint);text-align:center;margin-top:1.5rem}
.modal-print-btn{
  position:absolute;top:1rem;right:4.2rem;background:linear-gradient(135deg,var(--gold),#c4914f);
  color:#1c1306;border:none;padding:.5rem 1rem;border-radius:999px;cursor:pointer;
  font-size:.8rem;font-weight:700;font-family:'Outfit';display:flex;align-items:center;gap:.4rem
}

/* ── Printing a single lesson plan cleanly ───────────── */
@media print{
  body.printing-lesson-plan > *:not(.modal-overlay){display:none !important}
  body.printing-lesson-plan{background:#fff !important}
  body.printing-lesson-plan .modal-overlay{
    position:static !important;display:block !important;background:none !important;
    padding:0 !important;overflow:visible !important;inset:auto !important;height:auto !important
  }
  body.printing-lesson-plan .modal-box{
    box-shadow:none !important;border:none !important;max-width:100% !important;
    width:100% !important;padding:0 !important;background:#fff !important;
    position:static !important;margin:0 !important
  }
  body.printing-lesson-plan .modal-close,
  body.printing-lesson-plan .modal-print-btn,
  body.printing-lesson-plan .lp-print-note{display:none !important}
  body.printing-lesson-plan #lesson-plan-content{color:#111 !important}
  body.printing-lesson-plan .lp-title{color:#8a5e1a !important}
  body.printing-lesson-plan .lp-sub{color:#444 !important}
  body.printing-lesson-plan .lp-meta-item{
    background:#f5f2ea !important;border:1px solid #ccc !important;
    -webkit-print-color-adjust:exact;print-color-adjust:exact
  }
  body.printing-lesson-plan .lp-meta-item .k{color:#666 !important}
  body.printing-lesson-plan .lp-meta-item .v{color:#111 !important}
  body.printing-lesson-plan .lp-section h4{color:#0d6b63 !important;border-bottom:1px solid #ccc !important}
  body.printing-lesson-plan .lp-section li,
  body.printing-lesson-plan .lp-section p{color:#111 !important}
  body.printing-lesson-plan .lp-subblock{
    background:#f5f2ea !important;border-left:3px solid #0d6b63 !important;
    -webkit-print-color-adjust:exact;print-color-adjust:exact
  }
  body.printing-lesson-plan .lp-subblock strong{color:#8a5e1a !important}
  body.printing-lesson-plan .lp-agency-card{
    background:#f5f2ea !important;border:1px solid #ccc !important;
    -webkit-print-color-adjust:exact;print-color-adjust:exact
  }
  body.printing-lesson-plan .lp-agency-card h5{color:#8a5e1a !important}
  body.printing-lesson-plan .lp-agency-card p{color:#333 !important}
  body.printing-lesson-plan .lp-faith,
  body.printing-lesson-plan .lp-faith-verse{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  body.printing-lesson-plan .lp-section,
  body.printing-lesson-plan .lp-subblock,
  body.printing-lesson-plan .lp-agency-card,
  body.printing-lesson-plan .lp-faith{page-break-inside:avoid;break-inside:avoid}
  body.printing-lesson-plan .lp-meta-grid,
  body.printing-lesson-plan .lp-agency-grid{display:block !important}
  body.printing-lesson-plan .lp-meta-item,
  body.printing-lesson-plan .lp-agency-card{margin-bottom:.6rem}
  body.printing-all-plans .lp-print-page{page-break-after:always;break-after:page}
  body.printing-all-plans .lp-print-page:last-child{page-break-after:auto;break-after:auto}
  body.printing-lesson-plan .lp-week-tag{
    background:#f5f2ea !important;border:1px solid #c8922a !important;color:#8a5e1a !important;
    -webkit-print-color-adjust:exact;print-color-adjust:exact
  }
  @page{margin:1.5cm}
}

/* ── Error banner (missing data files) ───────────────── */
.data-error-banner{
  display:none;background:#3a1c1c;border:1px solid #c0392b;color:#ffd9d3;
  padding:.9rem 1.2rem;margin:1rem 1.5rem;border-radius:10px;font-size:.88rem
}
.data-error-banner.show{display:block}

@media (max-width:600px){
  .selector-bar{flex-direction:column;align-items:stretch}
  select{min-width:0;width:100%}
  .go-btn{align-self:stretch}
  .modal-print-btn{top:.7rem;right:auto;left:1rem;padding:.45rem .85rem;font-size:.74rem}
  .modal-box{padding-top:3.2rem}
}

/* ── Per-day trial square image ──────────────────────── */
.trial-img-wrap{
  margin:1.2rem 0;
  display:flex;flex-direction:column;align-items:center;gap:.5rem
}
.trial-img-wrap img{
  width:100%;max-width:420px;aspect-ratio:1/1;
  object-fit:cover;border-radius:12px;
  box-shadow:0 8px 24px rgba(0,0,0,.45);
  display:block;
}
.trial-img-wrap img.diagram{
  object-fit:contain;background:#fff;
}
.trial-img-caption{
  font-size:.73rem;color:var(--ink-faint);
  text-align:center;letter-spacing:.04em;max-width:420px;
}

/* ── Tama side-by-side story layout ─────────────────────── */
.tama-portrait{
  float:left;
  width:clamp(120px,30%,200px);
  margin:0 1.2rem 0.5rem 0;
}
.tama-portrait img{
  width:100%;height:auto;display:block;
  filter:drop-shadow(2px 4px 8px rgba(0,0,0,.3));
}
.crew-strip{
  position:relative;margin:0 0 .9rem;border-radius:12px;overflow:hidden;
  box-shadow:0 6px 18px rgba(0,0,0,.4);line-height:0;
}
.crew-strip .crew-base{width:100%;height:auto;display:block}
.crew-strip .crew-grey{
  position:absolute;top:0;left:0;width:100%;height:auto;
  filter:grayscale(1) brightness(.62);
  pointer-events:none;
}
.crew-strip .crew-focus{
  position:absolute;top:0;width:20%;
  box-shadow:inset 0 0 0 2px rgba(217,168,92,.9), 0 0 18px rgba(217,168,92,.3);
  border-radius:4px;pointer-events:none;
}
@media print{
  .crew-strip .crew-grey{filter:grayscale(1) brightness(.85)}
  .crew-strip .crew-focus{box-shadow:inset 0 0 0 2px #8a6a2f}
}
/* ── Term 3 intro / Meet the crew ─────────────────────── */
.crew-intro{max-width:760px;margin:0 auto;text-align:left}
.crew-intro h2{font-size:1.35rem;margin:0 0 .5rem;color:var(--gold);text-align:center;letter-spacing:.02em}
.crew-intro p{margin:0 0 .8rem;line-height:1.6}
.crew-intro .crew-sheet{
  width:100%;height:auto;display:block;margin:1rem 0 .4rem;
  border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.45);cursor:zoom-in;
}
.crew-intro .crew-sheet-hint{
  display:block;text-align:center;font-size:.73rem;color:var(--ink-faint);
  letter-spacing:.04em;margin-bottom:1rem;
}
.crew-names{display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;margin:.6rem 0 1rem}
.crew-name-card{
  flex:1 1 260px;background:rgba(255,255,255,.04);border:1px solid rgba(217,168,92,.28);
  border-radius:10px;padding:.7rem .9rem;
}
.crew-name-card strong{color:var(--gold);display:block;margin-bottom:.15rem}
.crew-name-card span{font-size:.85rem;line-height:1.5;display:block}
.crew-btn{
  margin-top:1.4rem;background:transparent;color:var(--gold);border:1px solid var(--gold);
  padding:.75rem 1.4rem;border-radius:8px;font-family:inherit;font-size:.9rem;
  font-weight:600;letter-spacing:.04em;cursor:pointer;
}
.crew-btn:hover{background:rgba(217,168,92,.12)}
.story-panel::after{
  content:'';display:table;clear:both;
}

/* ── Christian Perspective Card ──────────────────────── */
.faith-card{
  margin:.8rem auto 0;
  max-width:420px;
  background:linear-gradient(135deg,#fdf6e3 0%,#fef9ec 100%);
