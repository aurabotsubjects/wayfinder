<script>
const DAY_COLOURS_HEX = {Monday:'#e15c4f',Tuesday:'#e8954a',Wednesday:'#2ec4b6',Thursday:'#9b6fd1',Friday:'#e8c14a'}
const DAYS = ['Monday','Tuesday','Wednesday','Thursday','Friday']

// Your school's values, spelled out in full — used to expand the short value
// tags ("Love", "Know", "Serve", "Impact") stored against each trial.
const VALUES_MAP = {
  Love:   { maori: 'Aroha',   label: 'Aroha — Love',   desc: 'God, Others, Self, World' },
  Know:   { maori: 'Mōhio',   label: 'Mōhio — Know',   desc: 'God, His story and our place in it' },
